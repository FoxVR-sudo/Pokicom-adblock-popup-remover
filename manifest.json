{
  "manifest_version": 3,
  "name": "Popup & Overlay Blocker",
  "version": "2.1.0",
  "description": "Blocks popunder windows, click traps and intrusive ad overlays on filmizip.com and the vidmoly video embeds it loads.",
  "author": "FoxVR-sudo",
  "homepage_url": "https://github.com/FoxVR-sudo/filmizip-adblock-popup-remover",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["*://*/*"],
  "background": {
    "scripts": ["background.js"]
  },
  "action": {
    "default_title": "Popup & Overlay Blocker",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "*://filmizip.com/*",
        "*://*.filmizip.com/*",
        "*://vidmoly.biz/*",
        "*://*.vidmoly.biz/*"
      ],
      "js": ["content.js"],
      "css": ["style.css"],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "*://filmizip.com/*",
        "*://*.filmizip.com/*",
        "*://vidmoly.biz/*",
        "*://*.vidmoly.biz/*"
      ],
      "js": ["page-script.js"],
      "world": "MAIN",
      "run_at": "document_start",
      "all_frames": true
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "popup-overlay-blocker@foxvr-sudo",
      "strict_min_version": "128.0",
      "update_url": "https://raw.githubusercontent.com/FoxVR-sudo/filmizip-adblock-popup-remover/main/updates.json",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "gecko_android": {
      "strict_min_version": "128.0"
    }
  }
}
