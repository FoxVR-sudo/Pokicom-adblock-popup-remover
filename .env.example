# Copy this file to .env and fill in the values.
# .env is gitignored - never commit the real secret.
#
# Both values come from:
#   https://addons.mozilla.org/developers/addon/api/key/
#
# The secret is a password: anyone holding it can upload and sign add-ons
# under this AMO account. If it leaks, revoke it on that page and generate a
# new pair - revoking is instant.

WEB_EXT_API_KEY=
WEB_EXT_API_SECRET=
